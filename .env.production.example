APP_NAME=ERP Beauty Pro
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# Use una contraseña URL-encoded si contiene caracteres reservados.
DATABASE_URL=postgresql+psycopg://erp_beauty_pro:CAMBIAR@db:5432/erp_beauty_pro
SECRET_KEY=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_HOSTS=["localhost","backend","erp.example.com"]
CORS_ORIGINS=[]

POSTGRES_DB=erp_beauty_pro
POSTGRES_USER=erp_beauty_pro
POSTGRES_PASSWORD=CAMBIAR

FRONTEND_IMAGE=ghcr.io/luis-camayo-ing/system_peluqueria_frontend:latest
BACKEND_IMAGE=ghcr.io/luis-camayo-ing/system_peluqueria_backend:latest

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ERP Beauty Pro
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
